{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "sender_id": {
      "type": "string",
      "description": "User ID of the message sender"
    },
    "sender_name": {
      "type": "string",
      "description": "Display name of the sender (cached for fast rendering)"
    },
    "room_id": {
      "type": "string",
      "default": "global",
      "description": "Chat room identifier (e.g. global, lobby)"
    },
    "message": {
      "type": "string",
      "description": "Message text content"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "text",
        "challenge"
      ],
      "default": "text",
      "description": "Type of message \u2014 text or a game challenge invite"
    }
  },
  "required": [
    "sender_id",
    "sender_name",
    "message"
  ],
  "rls": {
    "create": {
      "data.sender_id": "{{user.id}}"
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}