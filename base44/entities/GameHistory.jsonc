{
  "name": "GameHistory",
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "ai",
        "local"
      ],
      "description": "Game mode - AI or local multiplayer"
    },
    "result": {
      "type": "string",
      "enum": [
        "white_wins",
        "black_wins",
        "draw",
        "in_progress"
      ],
      "default": "in_progress"
    },
    "moves_count": {
      "type": "number",
      "default": 0
    },
    "duration_seconds": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "mode"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}