{
  "name": "TournamentEntry",
  "type": "object",
  "properties": {
    "tournament_id": {
      "type": "string",
      "description": "Tournament this entry belongs to"
    },
    "user_id": {
      "type": "string",
      "description": "User who entered"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "refunded"
      ],
      "default": "pending"
    },
    "bracket_position": {
      "type": "number",
      "description": "Seed/position in the bracket (assigned when the tournament starts)"
    },
    "eliminated": {
      "type": "boolean",
      "default": false
    },
    "eliminated_round": {
      "type": "number",
      "description": "Bracket round in which this player was eliminated (used to stage the 3rd-place match)"
    },
    "placement": {
      "type": "number",
      "description": "Final standing: 1 = champion, 2 = runner-up, 3 = third place"
    },
    "refunded": {
      "type": "boolean",
      "default": false
    },
    "checkout_session_id": {
      "type": "string",
      "description": "Stripe checkout session for this buy-in"
    },
    "stripe_payment_intent": {
      "type": "string",
      "description": "Stripe payment intent used for refund handling"
    }
  },
  "required": [
    "tournament_id",
    "user_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}