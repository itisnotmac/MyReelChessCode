{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "is_premium": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has an active Premium subscription"
    },
    "username": {
      "type": "string",
      "description": "Display name shown to other players"
    },
    "avatar_url": {
      "type": "string",
      "description": "URL to the user's avatar image"
    }
  },
  "required": [
    "role"
  ]
}