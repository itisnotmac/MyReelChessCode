{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "username": {
      "type": "string",
      "description": "Display name shown to other players"
    },
    "avatar_url": {
      "type": "string",
      "description": "URL to the user's avatar image"
    },
    "feature_unlocks": {
      "type": "string",
      "description": "Comma-separated feature unlock IDs granted to this user without payment (e.g. 'qr_host_unlock,2v2_host_unlock'). Admins can edit this in the user management dashboard to manually grant unlocks."
    }
  },
  "required": [
    "role"
  ]
}