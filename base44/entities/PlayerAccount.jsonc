{
  "name": "PlayerAccount",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User ID this account belongs to"
    },
    "currency_balance": {
      "type": "number",
      "default": 0,
      "description": "In-game Reels balance in cents (100 = $1.00)"
    },
    "last_challenge_date": {
      "type": "string",
      "description": "YYYY-MM-DD (UTC) of the last day progress was tracked"
    },
    "daily_wins": {
      "type": "number",
      "default": 0,
      "description": "Wins today (any mode)"
    },
    "daily_ai_wins": {
      "type": "number",
      "default": 0,
      "description": "Wins against AI today"
    },
    "daily_local_wins": {
      "type": "number",
      "default": 0,
      "description": "Wins in local mode today"
    },
    "daily_games_played": {
      "type": "number",
      "default": 0,
      "description": "Total games completed today"
    },
    "claimed_today": {
      "type": "string",
      "default": "[]",
      "description": "JSON array of challenge IDs claimed today"
    },
    "daily_activities": {
      "type": "string",
      "default": "[]",
      "description": "JSON array of {type, label, time} activity entries for today's report card"
    },
    "login_streak": {
      "type": "number",
      "default": 0,
      "description": "Current consecutive day login streak"
    },
    "last_login_date": {
      "type": "string",
      "description": "YYYY-MM-DD of the last login day processed for streak"
    },
    "elo": {
      "type": "number",
      "default": 1200,
      "description": "Competitive ELO rating, updated by settleElo on finished 1v1 online games"
    },
    "peak_elo": {
      "type": "number",
      "default": 1200,
      "description": "Highest ELO rating the player has reached"
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}