{
  "name": "OnlineGame",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "waiting",
        "active",
        "finished"
      ],
      "default": "waiting"
    },
    "host_id": {
      "type": "string",
      "description": "User ID of the host (plays white)"
    },
    "guest_id": {
      "type": "string",
      "description": "User ID of the guest (plays black)"
    },
    "board": {
      "type": "string",
      "description": "JSON serialized board state"
    },
    "is_white_turn": {
      "type": "boolean",
      "default": true
    },
    "en_passant": {
      "type": "string",
      "description": "JSON serialized en passant target"
    },
    "castling": {
      "type": "string",
      "description": "JSON serialized castling rights"
    },
    "last_move": {
      "type": "string",
      "description": "JSON serialized last move"
    },
    "captured_white": {
      "type": "string",
      "description": "JSON array of captured white pieces"
    },
    "captured_black": {
      "type": "string",
      "description": "JSON array of captured black pieces"
    },
    "result": {
      "type": "string",
      "enum": [
        "white_wins",
        "black_wins",
        "draw",
        "in_progress"
      ],
      "default": "in_progress"
    },
    "move_count": {
      "type": "number",
      "default": 0
    },
    "invite_code": {
      "type": "string",
      "description": "Short code for joining the game"
    },
    "tournament_id": {
      "type": "string",
      "description": "Tournament this game belongs to (nullable for regular PVP)"
    },
    "tournament_round": {
      "type": "number",
      "default": 0,
      "description": "Bracket round this game belongs to (1 = first round)"
    },
    "tournament_settled": {
      "type": "boolean",
      "default": false,
      "description": "Whether this tournament game's result has been processed into the bracket"
    },
    "is_third_place": {
      "type": "boolean",
      "default": false,
      "description": "True for the 3rd-place playoff match (excluded from main-bracket advancement)"
    },
    "elo_settled": {
      "type": "boolean",
      "default": false,
      "description": "Whether this finished game's ELO has been applied to both players' ratings (idempotency guard)"
    },
    "elo_deltas": {
      "type": "string",
      "description": "JSON {host: n, guest: n} rating change applied to each player, written by settleElo so both clients can display the delta"
    }
  },
  "required": [
    "host_id"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.guest_id": "{{user.id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.host_id": "{{user.id}}"
        },
        {
          "data.guest_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "data.host_id": "{{user.id}}"
            },
            {
              "data.is_white_turn": true
            }
          ]
        },
        {
          "$and": [
            {
              "data.guest_id": "{{user.id}}"
            },
            {
              "data.is_white_turn": false
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.host_id": "{{user.id}}"
        },
        {
          "data.guest_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}