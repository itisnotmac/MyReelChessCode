{
  "name": "OnlineGame",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "waiting",
        "active",
        "finished"
      ],
      "default": "waiting"
    },
    "host_id": {
      "type": "string",
      "description": "User ID of the host (plays white)"
    },
    "guest_id": {
      "type": "string",
      "description": "User ID of the guest (plays black)"
    },
    "board": {
      "type": "string",
      "description": "JSON serialized board state"
    },
    "is_white_turn": {
      "type": "boolean",
      "default": true
    },
    "en_passant": {
      "type": "string",
      "description": "JSON serialized en passant target"
    },
    "castling": {
      "type": "string",
      "description": "JSON serialized castling rights"
    },
    "last_move": {
      "type": "string",
      "description": "JSON serialized last move"
    },
    "captured_white": {
      "type": "string",
      "description": "JSON array of captured white pieces"
    },
    "captured_black": {
      "type": "string",
      "description": "JSON array of captured black pieces"
    },
    "result": {
      "type": "string",
      "enum": [
        "white_wins",
        "black_wins",
        "draw",
        "in_progress"
      ],
      "default": "in_progress"
    },
    "move_count": {
      "type": "number",
      "default": 0
    },
    "invite_code": {
      "type": "string",
      "description": "Short code for joining the game"
    }
  },
  "required": [
    "host_id"
  ]
}