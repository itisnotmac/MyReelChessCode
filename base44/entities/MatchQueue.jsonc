{
  "name": "MatchQueue",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "The user waiting for a match"
    },
    "status": {
      "type": "string",
      "enum": [
        "waiting",
        "matched",
        "cancelled"
      ],
      "default": "waiting"
    },
    "game_id": {
      "type": "string",
      "description": "Assigned once matched"
    },
    "role": {
      "type": "string",
      "enum": [
        "host",
        "guest"
      ],
      "description": "Which side this player plays"
    },
    "region": {
      "type": "string",
      "enum": [
        "north-america",
        "south-america",
        "europe",
        "asia",
        "africa",
        "oceania",
        "unknown"
      ],
      "default": "unknown",
      "description": "Approximate geographic region used for matchmaking quality \u2014 derived from coarse timezone/locale, not GPS"
    },
    "mode": {
      "type": "string",
      "enum": [
        "classic",
        "blitz"
      ],
      "default": "classic",
      "description": "Matchmaking mode \u2014 'classic' for standard PVP, 'blitz' for BlitzSchach"
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}