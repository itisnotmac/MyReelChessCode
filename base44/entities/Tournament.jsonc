{
  "name": "Tournament",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Tournament display name"
    },
    "description": {
      "type": "string",
      "description": "Tournament description / rules text shown to players"
    },
    "buy_in_amount": {
      "type": "number",
      "default": 1000,
      "description": "Buy-in in cents (1000 = $10.00)"
    },
    "min_players": {
      "type": "number",
      "default": 200,
      "description": "Minimum paid entries required to run the tournament; below this, all buy-ins are refunded"
    },
    "max_players": {
      "type": "number",
      "description": "Optional player cap"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "registration",
        "active",
        "completed",
        "cancelled"
      ],
      "default": "draft",
      "description": "draft = wired but inert; registration = open for buy-ins; active = running; completed/cancelled = ended"
    },
    "start_time": {
      "type": "string",
      "format": "date-time",
      "description": "Scheduled tournament start time"
    },
    "paid_entries": {
      "type": "number",
      "default": 0,
      "description": "Count of paid entries (incremented atomically by the webhook)"
    },
    "prize_pool": {
      "type": "number",
      "default": 0,
      "description": "Total prize pool in cents (set when the tournament starts = buy_in * paid_entries)"
    },
    "prize_structure": {
      "type": "string",
      "default": "{\"house\": 30, \"1\": 32, \"2\": 16, \"3\": 8, \"4\": 6, \"5_8\": 8}",
      "description": "Payout split as percentages of the total prize pool: house=30%, 1st=32%, 2nd=16%, 3rd=8%, 4th=6%, 5th-8th split 8% equally"
    },
    "results": {
      "type": "string",
      "description": "JSON map of placement -> {id, name} for finalized placements, written as the bracket resolves"
    },
    "current_round": {
      "type": "number",
      "default": 0,
      "description": "Current bracket round (1 = first round); 0 before the tournament starts"
    },
    "rules": {
      "type": "object",
      "properties": {
        "cutscenes": {
          "type": "boolean",
          "default": false
        },
        "move_hints": {
          "type": "boolean",
          "default": false
        },
        "last_move_indicator": {
          "type": "boolean",
          "default": false
        },
        "three_d": {
          "type": "boolean",
          "default": false
        }
      },
      "description": "Tournament feature toggles \u2014 all off by default for competitive integrity"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}